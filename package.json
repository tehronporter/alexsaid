{
  "name": "hormozi-said",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && E2E_PRODUCTION=true playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:lighthouse": "npx --yes lighthouse@12.8.2 http://127.0.0.1:3000 --preset=desktop --only-categories=performance,accessibility --output=json --output-path=test-results/lighthouse.json --chrome-flags='--headless --no-sandbox' --quiet && node scripts/assert-lighthouse.mjs",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:validate:release": "RELEASE_CONTENT_ENFORCEMENT=true tsx scripts/validate-content.ts",
    "content:import": "tsx scripts/import-content.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "csv-parse": "^6.1.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}
